{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(exec|functions\\.exec|js|mcp__node_repl__js|node_repl\\.js)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/browser_evidence_hook.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}\\hooks\\browser_evidence_hook.py\"",
            "timeout": 10,
            "statusMessage": "Verifying Chrome evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/browser_evidence_hook.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}\\hooks\\browser_evidence_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking Chrome claims"
          }
        ]
      }
    ]
  }
}
