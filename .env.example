# Filled by .\setup-discord-bot.ps1 after installation.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
# Discord user IDs only; not channel IDs or server IDs. Host reboot commands also require DISCORD_ENABLE_HOST_COMMANDS=1 and a narrow trusted-user allowlist here.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOW_ALL_CHANNELS=0
DISCORD_STARTUP_CHANNEL_ID=
DISCORD_STARTUP_NOTIFY=1
DISCORD_ENABLE_MESSAGE_CONTENT=1
DISCORD_ENABLE_HOST_COMMANDS=0
DISCORD_PLAIN_ASK_MENTION_USER_IDS=
DISCORD_PLAIN_ASK_CONTEXT_FALLBACK=0
DISCORD_PLAIN_ASK_CONTEXT_KEYWORDS=codex,코덱스,bridge,브릿지,discord,디스코드,디코,bot,봇,응답,message,메시지,메세지,채팅,thread,스레드,queue,큐,steer,스티어,patch,패치,qa,하네스,harness,잘아타스
DISCORD_ENABLE_QA_COMMANDS=0
DISCORD_HISTORY_POLL_SECONDS=15
DISCORD_STEERING_DELIVERY_CONFIRM_TIMEOUT_SECONDS=25
DISCORD_STEERING_PENDING_WATCH_TIMEOUT_SECONDS=600
DISCORD_STALE_BUSY_STEER_BLOCK_SECONDS=600
DISCORD_STREAM_COMMENTARY=1
DISCORD_CHUNK_MARKERS=1
DISCORD_SESSION_MIRROR=1
DISCORD_SESSION_MIRROR_POLL_SECONDS=1
DISCORD_SESSION_MIRROR_ARCHIVE_BACKLOG_MAX_EVENTS=200
DISCORD_ENABLE_ATTACHMENTS=1
DISCORD_ATTACHMENT_MAX_BYTES=26214400
DISCORD_ATTACHMENT_TEXT_INLINE_MAX_BYTES=32768
DISCORD_ASK_BUSY_RETRY_ATTEMPTS=0
DISCORD_ASK_BUSY_RETRY_DELAY_SECONDS=8
CODEX_DISCORD_APP_SERVER_TRANSPORT=1
CODEX_DISCORD_APP_SERVER_LEGACY_FALLBACK=0
CODEX_DISCORD_LOG_PATH=
CODEX_HOME=
# Optional explicit override. The installer does not fill this from PATH.
CODEX_EXE=
CODEX_DESKTOP_EXE=
PYTHON_EXE=

# Optional !pro local-project bridge. Every PC needs its own device ID and token.
# Add the matching pair to the private gateway registry and keep it only in the
# local .env file on that PC.
CODEX_REMOTE_MCP_ENABLED=0
CODEX_REMOTE_MCP_BRIDGE_URL=wss://mcp.example.com/bridge
CODEX_REMOTE_MCP_DEVICE_ID=
CODEX_REMOTE_MCP_DEVICE_TOKEN=
CODEX_REMOTE_MCP_BINDING_TTL_SECONDS=1800
